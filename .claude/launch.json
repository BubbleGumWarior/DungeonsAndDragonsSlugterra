{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "slugterra-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--host"],
      "port": 5173,
      "cwd": "client",
      "autoPort": true
    },
    {
      "name": "slugterra-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 4000,
      "cwd": "server",
      "autoPort": true
    },
    {
      "name": "slugterra-client-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--host"],
      "port": 4173,
      "cwd": "client",
      "autoPort": true
    }
  ]
}
