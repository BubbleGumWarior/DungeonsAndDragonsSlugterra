node_modules/
dist/
.env
*.log

# Large source art -- ~400 MB of slug PNGs plus a zip of them. Input for
# server/scripts/generate-default-slug-templates.js; keep locally, never push.
docs/Images/
docs/Images.zip
*.zip

# Generated by server/scripts/generate-default-slug-templates.js from the
# images above (~50 MB, base64 slug art embedded). Rebuild locally; the server
# skips seeding if it's missing (see server/src/seedDefaultSlugs.js).
server/src/data/defaultSlugTemplates.json

# Python
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db

# Claude Code worktrees (full duplicate checkouts)
.claude/worktrees/

# DM-uploaded sound desk audio (see server/src/routes/sounds.js)
server/uploads/

# Sound Desk audio is never committed: DM uploads (server/uploads, above) and
# the drop-in folder server/default-sounds (plus its _originals backups).
# Other audio, such as the combat sounds in client/public, commits normally.
server/default-sounds/ambient/*
server/default-sounds/effects/*
server/default-sounds/_originals/
