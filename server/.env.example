PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=slugterra
JWT_SECRET=change_this_to_a_long_random_secret
PORT=4000

# Cloudflare Realtime TURN -- dash.cloudflare.com -> Realtime -> TURN Server
# -> Create. Gives a Turn Token ID and an API token. Powers voice chat's
# cross-network connectivity (first 1,000 GB/mo free); without any TURN
# config, voice chat falls back to STUN-only, which often can't connect two
# people on different networks.
CLOUDFLARE_TURN_KEY_ID=your_turn_token_id
CLOUDFLARE_TURN_API_TOKEN=your_turn_api_token

# Optional legacy fallback, only used if the Cloudflare pair above is unset.
# Metered.ca TURN REST URL (dashboard.metered.ca).
# METERED_TURN_CREDENTIALS_URL=https://yourapp.metered.live/api/v1/turn/credentials?apiKey=your_api_key
