PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=slugterra
JWT_SECRET=change_this_to_a_long_random_secret
PORT=4000

# Metered.ca TURN server -- sign up free at dashboard.metered.ca, create a
# TURN credential, and paste the full REST URL it gives you (includes your
# app subdomain + API key) here. Powers voice chat's cross-network
# connectivity; without it, voice chat falls back to STUN-only, which
# often can't connect two people on different networks.
METERED_TURN_CREDENTIALS_URL=https://yourapp.metered.live/api/v1/turn/credentials?apiKey=your_api_key
